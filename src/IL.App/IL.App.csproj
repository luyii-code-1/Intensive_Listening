<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><Version>2.0.0</Version><ApplicationIcon>../../windows/runner/resources/app_icon.ico</ApplicationIcon><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault></PropertyGroup>
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT')">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IL.Core/IL.Core.csproj" />
    <Content Include="../../assets/telemetry/**" Link="assets/telemetry/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
  <ItemGroup><Content Include="../../assets/legal/**" Link="assets/legal/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../../assets/fonts/LICENSE.txt" Link="assets/legal/source-han-sans-license.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><AvaloniaResource Include="../../assets/fonts/HarmonyOS_Sans_SC_*.ttf;../../assets/fonts/FluentIcons.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><AvaloniaResource Include="../../windows/runner/resources/app_icon.ico" Link="Assets/app_icon.ico" /></ItemGroup>
  <ItemGroup><AvaloniaResource Include="../../assets/app_logo.png" Link="Assets/app_logo.png" /></ItemGroup>
</Project>
