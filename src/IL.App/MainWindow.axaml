<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:IL.App.Views" xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia" x:Class="IL.App.MainWindow" Width="1440" Height="900" MinWidth="720" MinHeight="560" Title="Intensive Listening">
  <Grid Name="RootLayer" RowDefinitions="32,Auto,*" Background="{DynamicResource WorkspacePaneBrush}">
    <Grid ColumnDefinitions="*,Auto">
      <Border Name="TitleDragArea" Background="Transparent">
        <TextBlock Text="Intensive Listening" FontSize="12" Margin="12,0" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Name="MinimizeWindow" Classes="subtle" Content="&#xE921;" FontFamily="avares://IL.App/Assets/Fonts#Fabric MDL2 Assets" Width="46" Height="32" Padding="0" AutomationProperties.Name="最小化" />
        <Button Name="MaximizeWindow" Classes="subtle" Content="&#xE922;" FontFamily="avares://IL.App/Assets/Fonts#Fabric MDL2 Assets" Width="46" Height="32" Padding="0" AutomationProperties.Name="最大化或还原" />
        <Button Name="CloseWindow" Classes="subtle" Content="&#xE8BB;" FontFamily="avares://IL.App/Assets/Fonts#Fabric MDL2 Assets" Width="46" Height="32" Padding="0" AutomationProperties.Name="关闭" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Name="ManagedBanner" IsVisible="False" FontSize="11" Opacity="0.55" Margin="16,5" />
    <Grid Grid.Row="2" Name="ShellGrid" ColumnDefinitions="320,*">
      <Border Name="NavigationPane" Background="{DynamicResource WorkspacePaneBrush}">
        <Grid RowDefinitions="42,*,Auto" Margin="4,0">
          <Button Name="PaneToggle" Classes="subtle" HorizontalAlignment="Left" Width="40" Height="40" Padding="0" />
          <StackPanel Grid.Row="1" Spacing="4">
            <Button Name="StudentButton" Classes="nav selected" />
            <Button Name="TeacherButton" Classes="nav" />
            <Button Name="SettingsButton" Classes="nav" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="8" Margin="4,0,4,4">
            <Separator />
            <Button Name="QueueButton" Classes="nav" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource WorkspaceBackgroundBrush}" BorderBrush="{DynamicResource WorkspaceCardBorderBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
        <views:WorkspaceContentHost Name="PageHost" />
      </Border>
    </Grid>
    <fa:FAProgressRing Grid.Row="2" Name="NavigationBusy" IsVisible="False" IsActive="True" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" IsHitTestVisible="False" />
    <Border Grid.Row="2" Name="AgentOverlay" IsVisible="False" Background="#2E000000">
      <Border MaxWidth="640" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24" Padding="28,24" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Name="AgentTakeoverText" Text="智能体正在工作" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="课程制作数据正在由 MCP 智能体处理" TextWrapping="Wrap" />
          </StackPanel>
          <ContentControl Name="AgentProgressHost" />
          <Button Name="AgentButton" Content="强制断开" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
